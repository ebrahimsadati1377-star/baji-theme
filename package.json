{
  "name": "bajistyle",
  "version": "1.0.0",
  "description": "قالب وردپرس لوکس BajiStyle برای فروشگاه پوشاک زنانه، مبتنی بر Tailwind CSS و JavaScript ماژولار",
  "private": true,
  "license": "GPL-2.0-or-later",
  "scripts": {
    "dev": "concurrently \"npm:watch:css\" \"npm:watch:js\"",
    "build": "npm run build:css && npm run build:js",
    "build:css": "tailwindcss -i ./assets/css/tailwind-source.css -o ./assets/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i ./assets/css/tailwind-source.css -o ./assets/css/tailwind.css --watch",
    "build:js": "webpack --mode production",
    "watch:js": "webpack --mode development --watch",
    "lint:js": "eslint assets/js --ext .js",
    "lint:css": "stylelint \"assets/css/**/*.css\"",
    "lint": "npm run lint:js && npm run lint:css"
  },
  "devDependencies": {
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@tailwindcss/forms": "^0.5.7",
    "autoprefixer": "^10.4.19",
    "babel-loader": "^9.1.3",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "postcss": "^8.4.38",
    "stylelint": "^16.6.1",
    "stylelint-config-standard": "^36.0.0",
    "tailwindcss": "^3.4.4",
    "webpack": "^5.91.0",
    "webpack-cli": "^5.1.4"
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead"
  ]
}
